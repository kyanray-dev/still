+#if defined(__APPLE__)
+// Both the application delegate and the ready handshake run on the main queue.
+// Retain first-launch Apple events until the frontend has installed its listener.
+vector<string> pendingOpenFiles;
+bool fileOpenEventsReady = false;
+
+void enableFileOpenEvents() {
+    fileOpenEventsReady = true;
+    if(!pendingOpenFiles.empty()) {
+        vector<string> paths;
+        paths.swap(pendingOpenFiles);
+        events::dispatch("filesOpened", paths);
+    }
+}
+#endif
 
