+    #if defined(__x86_64__)
+    CGRect winPos = ((CGRect (*)(id, SEL))objc_msgSend_stret)(
+    #else
     CGRect winPos = ((CGRect (*)(id, SEL))objc_msgSend)(
+    #endif
         (id) windowHandle, "frame"_sel);
     return winPos;
 }
@@ -1263,7 +1269,11 @@
     #elif defined(__APPLE__)
     CGRect frameRect = __getWindowRect();
     CGRect clientRect =
