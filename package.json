{
  "name": "still-markdown",
  "version": "1.2.0",
  "private": true,
  "license": "0BSD",
  "engines": { "node": "^22.22.2 || ^24.15.0 || >=26.0.0" },
  "homepage": "https://github.com/kyanray-dev/still",
  "repository": { "type": "git", "url": "https://github.com/kyanray-dev/still.git" },
  "bugs": { "url": "https://github.com/kyanray-dev/still/issues" },
  "description": "A quiet, lightweight Markdown editor and reader for Windows and macOS.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:web": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "native:update": "neu update",
    "native:run": "neu run",
    "build": "npm run build:web && neu build",
    "package": "node scripts/package.mjs",
    "package:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "@mdit/plugin-katex": "1.1.3",
    "@neutralinojs/lib": "6.10.0",
    "dompurify": "3.4.16",
    "highlight.js": "11.12.0",
    "katex": "0.18.10",
    "markdown-it": "15.0.2",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-task-lists": "2.1.1",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "1.13.8",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-basic": "1.2.5",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-transform": "1.12.2",
    "prosemirror-view": "1.42.6"
  },
  "devDependencies": {
    "@neutralinojs/neu": "11.8.0",
    "@playwright/test": "1.63.0",
    "@types/markdown-it": "14.2.0",
    "@types/markdown-it-footnote": "3.0.4",
    "@types/node": "26.6.4",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
