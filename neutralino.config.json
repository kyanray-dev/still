{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "app.liubai.reader",
  "applicationName": "留白",
  "version": "1.2.0",
  "description": "A quiet place for Markdown.",
  "applicationIcon": "public/app-icon.png",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/dist-web/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "dataLocation": "system",
  "storageLocation": "system",
  "logging": { "enabled": false, "writeToLogFile": false },
  "nativeAllowList": [
    "app.exit",
    "os.showOpenDialog",
    "os.showSaveDialog",
    "os.open",
    "filesystem.getStats",
    "filesystem.readBinaryFile",
    "filesystem.writeFile",
    "filesystem.copy",
    "filesystem.access",
    "filesystem.move",
    "filesystem.remove",
    "storage.getData",
    "storage.setData",
    "window.print"
  ],
  "modes": {
    "window": {
      "title": "留白",
      "width": 1180,
      "height": 820,
      "minWidth": 680,
      "minHeight": 480,
      "center": true,
      "borderless": false,
      "resizable": true,
      "useLogicalPixels": true,
      "useSavedState": true,
      "exitProcessOnClose": false,
      "enableInspector": false,
      "injectGlobals": true,
      "injectClientLibrary": false,
      "emitDropEvents": true,
      "newWindowPolicy": "custom",
      "icon": "/dist-web/app-icon.png"
    }
  },
  "cli": {
    "binaryName": "liubai",
    "resourcesPath": "/dist-web/",
    "binaryVersion": "6.10.0",
    "clientVersion": "6.10.0",
    "distributionPath": "/dist-native/"
  }
}
